<div class="wildharvest-dialog wildharvest-player-layout wildharvest-player-layout--invite">
  <header class="wildharvest-player-head">
    <i class="{{icons.wildharvest}} wh-icon wh-icon--lg wildharvest-player-head__icon" aria-hidden="true"></i>
    <div class="wildharvest-player-head__copy">
      <p class="wildharvest-player-head__eyebrow">{{sceneTitle}}</p>
      <h2>{{activityName}}</h2>
      <p class="wildharvest-player-head__check"><i class="{{icons.skill}} wh-icon wh-icon--sm" aria-hidden="true"></i> {{skillCheck}}</p>
    </div>
  </header>
  <p class="wildharvest-player-copy">{{description}}</p>
  <p class="wildharvest-player-copy wildharvest-player-copy--lead">{{prompt}}</p>
</div>
