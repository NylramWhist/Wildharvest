<section class="wildharvest-player-hero">
  <div class="wildharvest-player-hero__emblem wh-icon-frame">
    <i class="{{icon}} wh-icon wh-icon--lg" aria-hidden="true"></i>
  </div>
  <div class="wildharvest-player-hero__copy">
    <h2>{{title}}</h2>
    {{#if subtitle}}<p data-search-hero-subtitle>{{subtitle}}</p>{{/if}}
    <div class="wildharvest-player-hero__divider" aria-hidden="true"></div>
  </div>
</section>
